{
  "name": "wayfarer-game-saves",
  "version": "1.1.1",
  "description": "Take your game saves with you. Portable Windows save transfer manager.",
  "author": {
    "name": "How1Come",
    "url": "https://github.com/How1Come"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "catalog:update": "node scripts/update-catalog.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:win:arm64": "npm run build && electron-builder --win portable --arm64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "picomatch": "^4.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "yaml": "^2.8.0"
  },
  "build": {
    "appId": "app.wayfarer.saves",
    "productName": "Wayfarer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/**/*",
      "assets/**/*",
      "docs/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Wayfarer-${version}-win-${arch}.exe",
      "requestExecutionLevel": "user"
    }
  }
}
